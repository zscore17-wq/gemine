## 8. 10 TA PARALLEL SO'ROV UCHUN CONCURRENCY TEST

Ushbu test bir xil foydalanuvchi va bir xil idempotency kaliti bilan kelgan **10 ta parallel so'rovdan faqat 1 tasi bajarilishini** va balans **faqat 1 marta yechilishini** tasdiqlaydi.

```python
# test_concurrency.py
import concurrent.futures
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

from models import Base, User, Purchase
from schemas import PurchaseRequest
from service import execute_purchase

DATABASE_URL = "postgresql://postgres:postgres@localhost:5432/test_db"
engine = create_engine(DATABASE_URL, pool_size=20, max_overflow=10)
SessionLocal = sessionmaker(bind=engine)

def run_parallel_purchase(user_id: int, key: str):
    db = SessionLocal()
    try:
        req = PurchaseRequest(user_id=user_id, price=10000, idempotency_key=key)
        return execute_purchase(db, req)
    except Exception as e:
        return {"error": str(e)}
    finally:
        db.close()

def test_ten_parallel_requests_single_execution():
    Base.metadata.drop_all(bind=engine)
    Base.metadata.create_all(bind=engine)

    # User balansi = 50,000 (Faqat 1 ta xaridga yetadi deb hisoblasak ham)
    init_db = SessionLocal()
    user = User(telegram_id="tg_parallel", balance=50000)
    init_db.add(user)
    init_db.commit()
    user_id = user.id
    init_db.close()

    idempotency_key = "parallel_tx_key_999"

    # 10 ta oqim (thread) orqali parallel so'rov yuboramiz
    with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:
        futures = [
            executor.submit(run_parallel_purchase, user_id, idempotency_key)
            for _ in range(10)
        ]
        results = [f.result() for f in concurrent.futures.as_completed(futures)]

    # TEKSHIRUV
    check_db = SessionLocal()
    final_user = check_db.query(User).get(user_id)
    purchases_count = check_db.query(Purchase).filter(
        Purchase.user_id == user_id, 
        Purchase.idempotency_key == idempotency_key
    ).count()

    # 1. Balans 50000 - 10000 = 40000 bo'lishi shart (Double spending bo'lmagan)
    assert final_user.balance == 40000
    # 2. Idempotency yozuvi bazada FAQAT 1 ta bo'lishi shart
    assert purchases_count == 1
    
    check_db.close()

```

