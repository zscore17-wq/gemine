### `service.py`

```python
import time
from datetime import datetime, timedelta, timezone
from functools import wraps
from sqlalchemy.orm import Session
from sqlalchemy.exc import OperationalError, IntegrityError
from fastapi import HTTPException, status

from models import User, Purchase
from schemas import PurchaseRequest, TransactionProcessingError

def retry_on_db_lock(retries=3, backoff_factor=0.1):
    """
    Deadlock (40P01) yoki Serialization Failure (40001) yuzaga kelganda
    Exponential Backoff bilan qayta urinish dekoratori.
    """
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            for attempt in range(retries):
                try:
                    return func(*args, **kwargs)
                except OperationalError as e:
                    orig_code = getattr(e.orig, "pgcode", None)
                    if orig_code in ("40P01", "40001") and attempt < retries - 1:
                        time.sleep(backoff_factor * (2 ** attempt))
                        continue
                    raise
        return wrapper
    return decorator


@retry_on_db_lock(retries=3, backoff_factor=0.1)
def execute_purchase(db: Session, req: PurchaseRequest) -> dict:
    """
    Atmik, Idempotent va Row-Level Lock bilan himoyalangan xarid funksiyasi.
    """
    # 1. IDEMPOTENCY KEY CHECK & LOCK
    # Idempotency yozuvini blokirovka bilan o'qiymiz
    existing_purchase = db.query(Purchase).filter(
        Purchase.user_id == req.user_id,
        Purchase.idempotency_key == req.idempotency_key
    ).with_for_update().first()

    if existing_purchase:
        if existing_purchase.status == "COMPLETED":
            return existing_purchase.response_payload
        elif existing_purchase.status == "PROCESSING":
            raise HTTPException(
                status_code=status.HTTP_409_CONFLICT,
                detail="Ushbu tranzaksiya hozirda boshqa oqim tomonidan bajarilmoqda. Birozdan so'ng qayta urinib ko'ring."
            )
        elif existing_purchase.status == "FAILED":
            return existing_purchase.response_payload

    # 2. Yangi Idempotency yozuvini 'PROCESSING' holatida yaratamiz
    new_purchase = Purchase(
        user_id=req.user_id,
        idempotency_key=req.idempotency_key,
        price=req.price,
        status="PROCESSING"
    )
    
    try:
        db.add(new_purchase)
        db.flush()  # DB Unique Constraint tekshiruvidan o'tkazamiz
    except IntegrityError:
        db.rollback()
        # Parallel so'rov soniya ichida yozuvni kiritingan bo'lsa, uni qayta o'qiymiz
        retry_record = db.query(Purchase).filter(
            Purchase.user_id == req.user_id,
            Purchase.idempotency_key == req.idempotency_key
        ).with_for_update().first()
        
        if retry_record and retry_record.status == "COMPLETED":
            return retry_record.response_payload
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="Parallel so'rovlar to'qnashuvi yuz berdi."
        )

    # 3. USER ROW-LEVEL LOCKING (SELECT ... FOR UPDATE)
    user = db.query(User).filter(User.id == req.user_id).with_for_update().first()

    if not user:
        result_payload = {"success": False, "reason": "User not found"}
        new_purchase.status = "FAILED"
        new_purchase.response_payload = result_payload
        db.commit()
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Foydalanuvchi topilmadi")

    # 4. BALANS TEKSHIRUVI
    if user.balance < req.price:
        result_payload = {"success": False, "reason": "Insufficient balance"}
        new_purchase.status = "FAILED"
        new_purchase.response_payload = result_payload
        db.commit()
        return result_payload

    # 5. ATOMAR MOLIYAVIY VA OBUNA AMALLARI (UTC POLICY)
    user.balance -= req.price
    user.is_premium = True

    now_utc = datetime.now(timezone.utc)
    if user.premium_expires_at and user.premium_expires_at > now_utc:
        user.premium_expires_at += timedelta(days=30)
    else:
        user.premium_expires_at = now_utc + timedelta(days=30)

    # 6. TRANZAKSIYANI YAKUNLASH VA MUVAFFAQIYATLI JAVOBNI SAQLASH
    result_payload = {
        "success": True,
        "new_balance": user.balance,
        "premium_expires_at": user.premium_expires_at.isoformat(),
        "idempotency_key": req.idempotency_key
    }
    
    new_purchase.status = "COMPLETED"
    new_purchase.response_payload = result_payload

    # Yagona atomar commit
    db.commit()
    return result_payload

```

