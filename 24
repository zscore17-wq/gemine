### 6. POSTGRESQL UCHUN XAVFSIZ PURCHASE ARXITEKTURASI (REF ACTORED CODE)

```python
from datetime import datetime, timedelta, timezone
from sqlalchemy.orm import Session
from sqlalchemy.exc import IntegrityError
from fastapi import HTTPException, status

def purchase_safe(user_id: int, price: int, transaction_id: str, db: Session) -> dict:
    """
    Atomar, Idempotent va Row-Level Lock bilan himoyalangan xarid funksiyasi.
    """
    try:
        # 1. IDEMPOTENCY CHECK: Tranzaksiya ilgari bajarilganini tekshirish
        existing_purchase = db.query(Purchase).filter(
            Purchase.transaction_id == transaction_id
        ).first()

        if existing_purchase:
            return {
                "success": True, 
                "message": "Transaction already processed", 
                "already_processed": True
            }

        # 2. ROW-LEVEL LOCKING: User qatorini bloklaymiz (Pessimistic Lock)
        # Boshqa parallel so'rovlar shu qator bo'yicha ushbu tranzaksiya tugaguncha kutadi.
        user = db.query(User).filter(
            User.id == user_id
        ).with_for_update().first()

        if not user:
            raise HTTPException(status_code=404, detail="User not found")

        # 3. BALANS VA SHARTLAR TEKSHIRUVI
        if user.balance < price:
            return {"success": False, "reason": "Insufficient balance"}

        # 4. BARCHA O'ZGARISHLARNI XOTIRADA BAJARISH (YAGONA TRANZAKSIYA)
        user.balance -= price
        user.is_premium = True
        
        now = datetime.now(timezone.utc)
        if user.premium_expires_at and user.premium_expires_at > now:
            user.premium_expires_at += timedelta(days=30)
        else:
            user.premium_expires_at = now + timedelta(days=30)

        purchase_record = Purchase(
            user_id=user_id,
            transaction_id=transaction_id
        )
        db.add(purchase_record)

        # 5. YAGONA ATOMAR COMMIT
        db.commit()
        return {"success": True}

    except IntegrityError:
        # DB level UNIQUE constraint urilganda (Parallel idempotency fallback)
        db.rollback()
        return {
            "success": True, 
            "message": "Concurrent duplicate request handled", 
            "already_processed": True
        }
    except Exception as e:
        db.rollback()
        raise e

```

