## 8. Deployment Plan & Infrastructure

Deployment utilizes Docker containers coordinated via Docker Compose behind Nginx for production setups.

```yaml
version: '3.8'

services:
  nginx:
    image: nginx:alpine
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./certs:/etc/letsencrypt:ro
    depends_on:
      - backend

  backend:
    build: .
    command: gunicorn app.main:app -w 4 -k uvicorn.workers.UvicornWorker -b 0.0.0.0:8000
    environment:
      - DATABASE_URL=postgresql+asyncpg://app_user:${DB_PASSWORD}@postgres:5432/telegram_os
      - REDIS_URL=redis://redis:6379/0
      - BOT_TOKEN=${BOT_TOKEN}
      - JWT_SECRET=${JWT_SECRET}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  bot_worker:
    build: .
    command: python -m app.bot.bot
    environment:
      - DATABASE_URL=postgresql+asyncpg://app_user:${DB_PASSWORD}@postgres:5432/telegram_os
      - REDIS_URL=redis://redis:6379/0
      - BOT_TOKEN=${BOT_TOKEN}
    depends_on:
      - backend

  async_worker:
    build: .
    command: arq app.workers.worker.WorkerSettings
    environment:
      - DATABASE_URL=postgresql+asyncpg://app_user:${DB_PASSWORD}@postgres:5432/telegram_os
      - REDIS_URL=redis://redis:6379/0
    depends_on:
      - backend

  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: app_user
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: telegram_os
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app_user -d telegram_os"]
      interval: 5s
      timeout: 5s
      retries: 5
    volumes:
      - pg_data:/var/lib/postgresql/data

  redis:
    image: redis:7-alpine
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  pg_data:

```

### Backup & Disaster Recovery

* **Database Backups:** Daily automated `pg_dump` cron execution targeting encrypted offsite S3-compatible storage with a 30-day retention policy.
* **Write-Ahead Logging (WAL):** Postgres WAL archiving enabled for point-in-time recovery (PITR) within a 24-hour window.

