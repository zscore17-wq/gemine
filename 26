async def verify_payme_auth(request: Request):
    """Payme uchun Basic Auth va IP Allowlist tekshiruvi"""
    # 1. IP Check
    client_ip = request.client.host
    # Production muhitida Nginx X-Forwarded-For un unumli foydalaning
    # if client_ip not in ALLOWED_PAYME_IPS:
    #     raise HTTPException(403, "IP not allowed")

    # 2. Basic Auth Check
    auth_header = request.headers.get("Authorization")
    if not auth_header or not auth_header.startswith("Basic "):
        raise HTTPException(401, "Missing Auth Header")

