### C. Admin Access Control Model (RBAC)

```python
from fastapi import Depends, HTTPException, status
from models import User

def get_current_admin_user(
    current_user: TelegramUser = Depends(verify_telegram_init_data),
    db: Session = Depends(get_db)
) -> User:
    """
    Admin huquqini tekshiruvchi qat'iy Guard Middleware
    """
    user = db.query(User).filter(User.telegram_id == str(current_user.id)).first()
    
    if not user:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="User not found")

    if not user.is_admin or user.is_blocked:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN, 
            detail="Access Denied: Admin privileges required"
        )

    return user

# Xavfsiz Admin Endpoint
@app.post("/admin/users/{user_id}/block")
async def block_user(
    user_id: int,
    admin: User = Depends(get_current_admin_user), # Admin guard majburiy
    db: Session = Depends(get_db)
):
    target_user = db.query(User).filter(User.id == user_id).first()
    if not target_user:
        raise HTTPException(404, "User not found")

    target_user.is_blocked = True
    db.commit()
    return {"success": True, "blocked_by": admin.id}

```

