    assert response.status_code in (401, 403)

def test_invalid_x_user_id_header_ignored():
    """Soxta X-User-Id headeri orqali profil o'qish taqiqlanganini tekshirish"""
    response = client.get("/api/profile", headers={"X-User-Id": "1"})
    assert response.status_code == 401

