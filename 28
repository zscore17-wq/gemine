@pytest.mark.asyncio
async def test_idempotency_key_and_payload_matching(db_session):
    """7. Idempotency Key & Payload Hash Test"""
    user = User(telegram_id=5001, first_name="Idempotent User")
    db_session.add(user)
    await db_session.commit()

    payload_1 = "item=EPISODE&id=10&price=5000"
    hash_1 = hashlib.sha256(payload_1.encode()).hexdigest()

    purchase_1 = Purchase(
        user_id=user.id,
        idempotency_key="idempotency_key_abc",
        payload_hash=hash_1,
        item_type="EPISODE",
        item_id=10,
        price=5000,
        status="COMPLETED"
    )
    db_session.add(purchase_1)
    await db_session.commit()

    # Same idempotency key for same user must be blocked by DB Unique constraint
    payload_2 = "item=EPISODE&id=10&price=10000"  # Different payload
    hash_2 = hashlib.sha256(payload_2.encode()).hexdigest()

    purchase_2 = Purchase(
        user_id=user.id,
        idempotency_key="idempotency_key_abc",
        payload_hash=hash_2,
        item_type="EPISODE",
        item_id=10,
        price=10000,
        status="PROCESSING"
    )
    db_session.add(purchase_2)
    with pytest.raises(IntegrityError):
        await db_session.commit()
    await db_session.rollback()


@pytest.mark.asyncio
async def test_premium_subscription_history_and_source(db_session):
    """8. Premium Subscription History & Source Tracking Test"""
    user = User(telegram_id=6001, first_name="Premium User")
    admin = User(telegram_id=9001, first_name="Admin User", is_admin=True)
    tariff = PremiumTariff(days=30, price=30000, title="Month")
    db_session.add_all([user, admin, tariff])
    await db_session.commit()

    now = datetime.now(timezone.utc)
    
    # Subscription 1: Paid
    sub_paid = PremiumSubscription(
        user_id=user.id,
        tariff_id=tariff.id,
        source="PAYMENT",
        start_at=now,
        end_at=now + timedelta(days=30)
    )
    
    # Subscription 2: Gift by Admin
    sub_gift = PremiumSubscription(
        user_id=user.id,
        tariff_id=None,
        source="GIFT_ADMIN",
        start_at=now + timedelta(days=30),
        end_at=now + timedelta(days=60),
        granted_by_admin_id=admin.id
    )

    db_session.add_all([sub_paid, sub_gift])
    await db_session.commit()

    query = await db_session.execute(
        select(PremiumSubscription).where(PremiumSubscription.user_id == user.id)
    )
    subs = query.scalars().all()

    assert len(subs) == 2
    assert subs[0].source == "PAYMENT"
    assert subs[1].source == "GIFT_ADMIN"
    assert subs[1].granted_by_admin_id == admin.id

