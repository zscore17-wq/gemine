import hashlib
import pytest
from datetime import datetime, timedelta, timezone
from sqlalchemy.exc import IntegrityError
from sqlalchemy import select

from app.models import (
    User, Series, Season, Episode, UserPurchasedEpisode,
    StorageChannel, StorageMessage, PremiumTariff, PremiumSubscription,
    Purchase, PaymentTransaction
)


@pytest.mark.asyncio
async def test_database_connection(db_session):
    """1. DB Connection Test"""
    result = await db_session.execute(select(1))
    assert result.scalar() == 1


@pytest.mark.asyncio
async def test_foreign_key_constraints(db_session):
    """2. Foreign Key Relationships Test"""
    user = User(telegram_id=1001, first_name="Test User")
    db_session.add(user)
    await db_session.commit()

    series = Series(code="e1", title="Test Series")
    db_session.add(series)
    await db_session.commit()

    season = Season(series_id=series.id, season_number=1, title="Season 1")
    db_session.add(season)
    await db_session.commit()

    episode = Episode(season_id=season.id, episode_number=1, title="Episode 1")
    db_session.add(episode)
    await db_session.commit()

    assert episode.season_id == season.id
    assert season.series_id == series.id


@pytest.mark.asyncio
async def test_unique_constraints(db_session):
    """3. Unique Constraints Test (Telegram ID & Episode Duplicate Purchase)"""
    user1 = User(telegram_id=2001, first_name="User 1")
    db_session.add(user1)
    await db_session.commit()

    # Duplicate Telegram ID should raise IntegrityError
    user2 = User(telegram_id=2001, first_name="User 2")
    db_session.add(user2)
    with pytest.raises(IntegrityError):
        await db_session.commit()
    await db_session.rollback()

    # Test Duplicate Episode Purchase Prevention
    series = Series(code="e2", title="Series 2")
    season = Season(series=series, season_number=1)
    episode = Episode(season=season, episode_number=1)
    db_session.add_all([series, season, episode])
    await db_session.commit()

    purchased_1 = UserPurchasedEpisode(user_id=user1.id, episode_id=episode.id)
    db_session.add(purchased_1)
    await db_session.commit()

    # Duplicate episode purchase for same user must fail
    purchased_2 = UserPurchasedEpisode(user_id=user1.id, episode_id=episode.id)
    db_session.add(purchased_2)
    with pytest.raises(IntegrityError):
        await db_session.commit()
    await db_session.rollback()


