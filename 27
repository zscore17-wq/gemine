### 4. Database ER Modeli (Database Schema Design)

PostgreSQL uchun SQLAlchemy 2.0 Async declarative modellari asosida loyihalashtirilgan relyatsion sxema:

```sql
-- 1. Users Table
CREATE TABLE users (
    id BIGSERIAL PRIMARY KEY,
    telegram_id VARCHAR(64) NOT NULL UNIQUE,
    username VARCHAR(64),
    first_name VARCHAR(128),
    balance BIGINT NOT NULL DEFAULT 0 CHECK (balance >= 0),
    is_admin BOOLEAN NOT NULL DEFAULT FALSE,
    is_blocked BOOLEAN NOT NULL DEFAULT FALSE,
    premium_expires_at TIMESTAMPTZ NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 2. Storage Channels Table
CREATE TABLE storage_channels (
    id SERIAL PRIMARY KEY,
    channel_id BIGINT NOT NULL UNIQUE,
    channel_title VARCHAR(255) NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 3. Series Table
CREATE TABLE series (
    id SERIAL PRIMARY KEY,
    code VARCHAR(32) NOT NULL UNIQUE, -- e.g., 'e1'
    title VARCHAR(255) NOT NULL,
    description TEXT,
    poster_url VARCHAR(512),
    free_episodes_count INT NOT NULL DEFAULT 1 CHECK (free_episodes_count >= 0),
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 4. Seasons Table
CREATE TABLE seasons (
    id SERIAL PRIMARY KEY,
    series_id INT NOT NULL REFERENCES series(id) ON DELETE CASCADE,
    season_number INT NOT NULL,
    title VARCHAR(255),
    CONSTRAINT uq_series_season UNIQUE (series_id, season_number)
);

-- 5. Episodes Table
CREATE TABLE episodes (
    id SERIAL PRIMARY KEY,
    season_id INT NOT NULL REFERENCES seasons(id) ON DELETE CASCADE,
    episode_number INT NOT NULL,
    title VARCHAR(255),
    is_free BOOLEAN NOT NULL DEFAULT FALSE,
    price BIGINT NOT NULL DEFAULT 0 CHECK (price >= 0),
    telegram_file_id VARCHAR(512) NOT NULL,
    telegram_message_id BIGINT NOT NULL,
    storage_channel_id INT REFERENCES storage_channels(id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_season_episode UNIQUE (season_id, episode_number)
);

-- 6. Tariffs Table
CREATE TABLE tariffs (
    id SERIAL PRIMARY KEY,
    days INT NOT NULL CHECK (days > 0),
    price BIGINT NOT NULL CHECK (price > 0),
    title VARCHAR(128) NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT TRUE
);

-- 7. Purchases Table (Idempotent Transactions)
CREATE TABLE purchases (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    idempotency_key VARCHAR(128) NOT NULL,
    item_type VARCHAR(32) NOT NULL, -- 'PREMIUM', 'SERIES', 'EPISODE'
    item_id INT NULL,
    price BIGINT NOT NULL CHECK (price >= 0),
    status VARCHAR(20) NOT NULL DEFAULT 'PROCESSING', -- 'PROCESSING', 'COMPLETED', 'FAILED'
    response_payload JSONB NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_user_idempotency UNIQUE (user_id, idempotency_key)
);

-- 8. Mandatory Channels Table
CREATE TABLE mandatory_channels (
    id SERIAL PRIMARY KEY,
    channel_id VARCHAR(64) NOT NULL UNIQUE,
    channel_url VARCHAR(255) NOT NULL,
    title VARCHAR(255) NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT TRUE
);

-- 9. Audit Logs Table
CREATE TABLE audit_logs (
    id BIGSERIAL PRIMARY KEY,
    admin_id BIGINT REFERENCES users(id) ON DELETE SET NULL,
    action VARCHAR(128) NOT NULL,
    details JSONB NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

```

